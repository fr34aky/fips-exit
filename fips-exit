#!/usr/bin/env python3
"""fips-exit: turn a Linux fips node into an exit node.

Clients (fips2go, or any fips node) send their internet traffic to this node
as plain IP-in-IPv6 over the mesh (RFC 2473: next-header 4 for IPv4, 41 for
IPv6, no tunnel header, no encryption of its own - fips encrypts end to
end). The daemon fips-exitd moves those packets between the mesh and a TUN
device; this script is everything around it: the client list, the routes,
NAT to the uplink, and the firewall.

  fips-exit add <npub|fd-address> [name]   allow a client (and apply)
  fips-exit remove <npub|fd-address|name>  remove a client (and apply)
  fips-exit list                           the clients and their addresses
  fips-exit up                             apply the client list (needs fips-exitd running)
  fips-exit down                           remove everything this script made
  fips-exit status                         what is in place right now
  fips-exit accounts                       who else is carried, and for how much (ACCESS=paid)
  fips-exit advert [show]                  say on Nostr that this exit exists; or show what would be said

Needs root, iproute2, nftables, and fips-exitd (systemctl start fips-exit).
"""

import base64
import hashlib
import ipaddress
import json
import os
import re
import socket
import ssl
import struct
import subprocess
import sys
import time

DIR = os.environ.get("FIPS_EXIT_DIR", "/etc/fips-exit")
CLIENTS = os.path.join(DIR, "clients")
CONFIG = os.path.join(DIR, "config")

# The daemon's socket for accounts, when the config says ACCESS=paid.
CONTROL = os.environ.get("FIPS_EXIT_CONTROL", "/run/fips-exit/control.sock")

TABLE = "fips_exit"  # nftables table (inet)
ROUTE_TABLE = "5170"  # per-client IPv6 return routes
RULE_PRIORITY = "5170"
MESH = ipaddress.ip_network("fd00::/8")
# Where every client's inner IPv4 address is (inner_ipv4 below).
INNER4 = ipaddress.ip_network("100.64.0.0/10")
# In paid mode: one bit of the connection mark and of the packet mark, for
# the IPv6 connections that came out of the tunnel (ruleset, cmd_up). Set
# and read as that one bit, so that other users of the marks keep theirs.
MARK = "0x8000000"

# A mesh packet is at most 1280 bytes, so an inner packet beside the 40-byte
# outer header travels whole up to 1240 and as two fragments above that. TCP
# is kept whole by its MSS.
INNER_WHOLE = 1240
MSS4 = INNER_WHOLE - 40
MSS6 = INNER_WHOLE - 60


def die(message):
    sys.exit(f"fips-exit: {message}")


def run(*argv, check=True, stdin=None):
    done = subprocess.run(argv, input=stdin, capture_output=True, text=True)
    if check and done.returncode != 0:
        die(f"{' '.join(argv)}: {done.stderr.strip() or done.stdout.strip()}")
    return done


# --- addresses ---------------------------------------------------------------

BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def bech32_polymod(values):
    generator = [0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3]
    chk = 1
    for value in values:
        top = chk >> 25
        chk = (chk & 0x1FFFFFF) << 5 ^ value
        for i in range(5):
            chk ^= generator[i] if (top >> i) & 1 else 0
    return chk


def bech32_key(text, prefix):
    """The 32-byte key in an `npub1…` or an `nsec1…`."""
    text = text.strip().lower()
    head = prefix + "1"
    if not text.startswith(head) or any(c not in BECH32 for c in text[len(head):]):
        raise ValueError(f"not an {prefix}")
    data = [BECH32.index(c) for c in text[len(head):]]
    expanded = [ord(c) >> 5 for c in prefix] + [0] + [ord(c) & 31 for c in prefix]
    if bech32_polymod(expanded + data) != 1:
        raise ValueError(f"{prefix} checksum mismatch (mistyped?)")
    acc = bits = 0
    key = bytearray()
    for value in data[:-6]:
        acc = (acc << 5) | value
        bits += 5
        if bits >= 8:
            bits -= 8
            key.append((acc >> bits) & 0xFF)
    if len(key) != 32:
        raise ValueError(f"{prefix} is not a 32-byte key")
    return bytes(key)


def key_address(key):
    """The fips address of a public key: fd + the first 15 bytes of
    sha256(x-only key), as fips derives it."""
    return ipaddress.IPv6Address(b"\xfd" + hashlib.sha256(key).digest()[:15])


def npub_to_address(npub):
    return key_address(bech32_key(npub, "npub"))


def parse_client(text):
    """An npub or an fd address, as the client's fips address."""
    try:
        address = npub_to_address(text) if text.startswith("npub1") else ipaddress.IPv6Address(text)
    except ValueError as error:
        die(f"{text}: {error}")
    if address not in MESH:
        die(f"{address} is not a fips address (fd00::/8)")
    return address


def inner_ipv4(address):
    """The client's IPv4 address inside the tunnel: 100.64.0.0/10 with the
    low 22 bits of the three bytes after the fd of its fips address. The
    client derives the same value; fips-exitd (src/main.rs) and fips2go
    (shim/src/exit.rs) must agree with this, byte for byte."""
    a = address.packed
    bits = (a[1] << 16 | a[2] << 8 | a[3]) & 0x3FFFFF
    return ipaddress.IPv4Address(0x64400000 | bits)


# --- state -------------------------------------------------------------------


def load_clients():
    """[(address, name)] from the client list."""
    clients = []
    try:
        lines = open(CLIENTS).read().splitlines()
    except FileNotFoundError:
        return clients
    for line in lines:
        fields = line.split("#")[0].split()
        if fields:
            clients.append((ipaddress.IPv6Address(fields[0]), " ".join(fields[1:])))
    return clients


# Where a client may never be sent, whatever its packet says: this host's
# and the uplink's own networks, the other clients, and everything that is
# not the public internet. The uplink interface is usually the LAN as well,
# so "out of the uplink" alone lets a client reach the operator's router,
# NAS and printer. The same list as fips2go's exit container
# (exit-node/exitctl.py, BLOCKED_V4), plus its IPv6 counterpart, since this
# exit forwards IPv6 too.
BLOCKED_V4 = [
    "0.0.0.0/8",        # "this network"
    "10.0.0.0/8",       # private
    "100.64.0.0/10",    # carrier-grade NAT: the clients' own inner addresses
    "127.0.0.0/8",      # loopback
    "169.254.0.0/16",   # link-local
    "172.16.0.0/12",    # private
    "192.0.0.0/24",     # IETF protocol assignments
    "192.0.2.0/24",     # documentation
    "192.168.0.0/16",   # private
    "198.18.0.0/15",    # benchmarking
    "198.51.100.0/24",  # documentation
    "203.0.113.0/24",   # documentation
    "224.0.0.0/3",      # multicast, reserved, broadcast
]
BLOCKED_V6 = [
    # All of 0000::/8, which IANA reserves: unspecified, loopback,
    # IPv4-mapped and -compatible, and both NAT64 prefixes (64:ff9b::/96 and
    # 64:ff9b:1::/48). A NAT64 gateway on the uplink's network would turn
    # 64:ff9b::c0a8:101 into 192.168.1.1, so the prefix is a way round the
    # IPv4 list. The cost: an exit whose uplink is IPv6-only behind NAT64
    # cannot carry its clients' IPv6 connections to IPv4-only sites.
    "::/8",
    "100::/64",         # discard-only
    "2001::/32",        # Teredo
    "2001:db8::/32",    # documentation
    "2002::/16",        # 6to4: can carry a private IPv4 address inside
    "3fff::/20",        # documentation
    "fc00::/7",         # unique local, which includes the mesh (fd00::/8)
    "fe80::/10",        # link-local
    "fec0::/10",        # site-local (deprecated)
    "ff00::/8",         # multicast
]


def blocked(config):
    """(IPv4 networks, IPv6 networks) no client is forwarded to: the lists
    above and BLOCK_CIDRS from the config, which only ever adds. A value
    there that is not a network stops the script: a block the operator
    asked for and did not get would be silent."""
    v4, v6 = list(BLOCKED_V4), list(BLOCKED_V6)
    for text in config.get("BLOCK_CIDRS", "").replace(",", " ").split():
        try:
            network = ipaddress.ip_network(text, strict=False)
        except ValueError as error:
            die(f"BLOCK_CIDRS: {text}: {error}")
        (v4 if network.version == 4 else v6).append(str(network))
    return v4, v6


def served(clients, warn=True):
    """The clients the exit serves: the list, without any whose derived IPv4
    address an earlier line already has. `add` never writes such a line; a
    list edited by hand can hold one, and the daemon skips it the same way
    (the first keeps the address), so the routes and the firewall must not
    be built for it either."""
    out, by_inner = [], {}
    for address, name in clients:
        inner = inner_ipv4(address)
        other = by_inner.get(inner)
        if other is not None and other != address:
            if warn:
                print(f"fips-exit: {address} {name} has the same IPv4 address ({inner}) as "
                      f"{other}; not served. Remove one of them.", file=sys.stderr)
            continue
        if other is None:
            by_inner[inner] = address
            out.append((address, name))
    return out


def save_clients(clients):
    os.makedirs(DIR, exist_ok=True)
    temp = CLIENTS + ".tmp"
    with open(temp, "w") as out:
        out.write("# fips-exit clients: <fips address> [name]. Edit with fips-exit add/remove.\n")
        for address, name in clients:
            out.write(f"{address} {name}".rstrip() + "\n")
    os.replace(temp, CLIENTS)


def load_config():
    # TUN: the daemon's device. FIPS_FIREWALL: fips's own nftables file
    # (default-deny input on its TUN); empty = leave it alone.
    # ACCESS: who is carried. allow-list: the clients on the list. paid:
    # those, and the members of the accounts something makes in the daemon.
    config = {"MESH_IF": "fips0", "WAN": "", "TUN": "fipsexit0",
              "FIPS_FIREWALL": "/etc/fips/fips.nft", "ACCESS": "allow-list"}
    try:
        with open(CONFIG) as file:
            for line in file:
                key, _, value = line.partition("=")
                if key.strip() and not key.lstrip().startswith("#"):
                    config[key.strip()] = config_value(value)
    except FileNotFoundError:
        pass
    return config


def config_value(text):
    """What a line of the config sets: what is between double quotes when it
    begins with one, and otherwise what is in front of a `#`. A `#` between
    quotes is a `#`: a name may have one."""
    text = text.strip()
    closing = text.find('"', 1)
    if text.startswith('"') and closing > 0:
        return text[1:closing]
    return text.split("#")[0].strip().strip('"')


def paid(config):
    return config["ACCESS"] == "paid"


def control(line, wait=0.0):
    """One command to the daemon's control socket; its answer as lines, the
    last of which begins `ok` or `err`. None when there is no answer within
    `wait` seconds. No answer has two causes, and both pass: the daemon
    makes the socket a moment after its TUN device, which is what `up` at
    the start of the service waits for; and it serves a few peers at a time,
    closing the next one without a word."""
    deadline = time.monotonic() + wait
    while True:
        peer = socket.socket(socket.AF_UNIX)
        peer.settimeout(5)
        answer = b""
        try:
            peer.connect(CONTROL)
            peer.sendall(line.encode() + b"\n")
            peer.shutdown(socket.SHUT_WR)
            while True:
                data = peer.recv(65536)
                if not data:
                    break
                answer += data
        except OSError:
            answer = b""
        finally:
            peer.close()
        if answer:
            return answer.decode().splitlines()
        if time.monotonic() >= deadline:
            return None
        time.sleep(0.2)


def daemon_stat(wait=0.0):
    """The daemon's `stat` as a dict, or None when it has no socket."""
    answer = control("stat", wait)
    if not answer or not answer[-1].startswith("ok "):
        return None
    return dict(field.split("=", 1) for field in answer[-1].split()[1:] if "=" in field)


def uplink(config):
    if config["WAN"]:
        return config["WAN"]
    for family in ("-4", "-6"):
        routes = json.loads(run("ip", "-j", family, "route", "show", "default").stdout or "[]")
        for route in routes:
            if route.get("dev"):
                return route["dev"]
    die(f"no default route; set WAN=<interface> in {CONFIG}")


def mesh_address(config):
    shown = run("ip", "-j", "-6", "addr", "show", "dev", config["MESH_IF"], check=False)
    if shown.returncode != 0:
        die(f"no interface {config['MESH_IF']}: is fips running? (MESH_IF in {CONFIG})")
    for interface in json.loads(shown.stdout or "[]"):
        for info in interface.get("addr_info", []):
            address = ipaddress.IPv6Address(info["local"])
            if address in MESH:
                return address
    die(f"{config['MESH_IF']} has no fips address")


def inner_range_in_use(config):
    """What on this host already uses 100.64.0.0/10, other than the tunnel.

    In paid mode the whole range is routed to the TUN device, since the
    members are not known in advance. On a host that is in that range
    itself (an uplink behind carrier-grade NAT, Tailscale, a resolver at
    100.100.100.100), that route would take the host's own traffic."""
    tun, found = config["TUN"], []
    for interface in json.loads(run("ip", "-j", "-4", "addr", "show").stdout or "[]"):
        if interface.get("ifname") in (None, tun):
            continue
        for info in interface.get("addr_info", []):
            if info.get("local") and ipaddress.IPv4Address(info["local"]) in INNER4:
                found.append(f"the address {info['local']} on {interface['ifname']}")
    for route in json.loads(run("ip", "-j", "-4", "route", "show").stdout or "[]"):
        dst = route.get("dst")
        if dst in (None, "default") or route.get("dev") == tun:
            continue
        if ipaddress.ip_network(dst, strict=False).overlaps(INNER4):
            found.append(f"the route {dst} via {route.get('dev')}")
    # The resolvers: the host's own, which its own lookups go to whatever
    # the daemon forwards to, and the daemon's if the config names them
    # (src/main.rs, dns_upstreams).
    named = config.get("DNS_UPSTREAMS", "").replace(",", " ").split()
    try:
        named += [line.split()[1].split("%")[0] for line in open("/etc/resolv.conf")
                  if line.split("#")[0].split()[:1] == ["nameserver"] and len(line.split()) > 1]
    except OSError:
        pass
    for text in dict.fromkeys(named):
        try:
            if ipaddress.ip_address(text) in INNER4:
                found.append(f"the resolver {text}")
        except ValueError:
            pass
    return found


def tun_present(config):
    return run("ip", "link", "show", "dev", config["TUN"], check=False).returncode == 0


def remove_kernel_tunnels(config):
    """Undo what versions before the daemon set up: one ip6tnl device per
    client (fx…) and a DF-clearing tc filter on the uplink. Nothing here may
    stop `up` or `down`: what follows it matters more than what it clears."""
    try:
        links = json.loads(run("ip", "-j", "link", "show", "type", "ip6tnl", check=False).stdout or "[]")
    except ValueError:
        links = []
    for link in links:  # ip prints {} for each link the type filter drops
        name = link.get("ifname", "")
        if name.startswith("fx") and run("ip", "link", "del", name, check=False).returncode != 0:
            print(f"fips-exit: could not remove the old tunnel {name}", file=sys.stderr)
    wan = config["WAN"] or None
    if wan is None:
        routes = json.loads(run("ip", "-j", "route", "show", "default").stdout or "[]")
        wan = next((r["dev"] for r in routes if r.get("dev")), None)
    if wan:
        run("tc", "filter", "del", "dev", wan, "ingress", "pref", "5170", check=False)


# --- up / down ---------------------------------------------------------------


def sysctl(key, value):
    path = "/proc/sys/" + key.replace(".", "/")
    try:
        if open(path).read().strip() != value:
            open(path, "w").write(value)
    except OSError as error:
        die(f"sysctl {key}={value}: {error}")


def ruleset(clients, config, wan):
    """The whole nftables table, replaced in one transaction."""
    tun, mesh = config["TUN"], config["MESH_IF"]
    set4 = ", ".join(str(inner_ipv4(a)) for a, _ in clients)
    set6 = ", ".join(str(a) for a, _ in clients)
    blocked4, blocked6 = blocked(config)
    if paid(config):
        # The members of an account are not known here, so anything from the
        # clients' ranges may pass: the daemon has already admitted it, for
        # each packet, and is the only place where that is decided.
        from4, from6 = f"ip saddr != {INNER4} drop", f"ip6 saddr != {MESH} drop"
        # Mail between servers is not for someone who bought access. The
        # clients on the list are the operator's own.
        members_only = ("ip saddr != @clients4 tcp dport 25 drop\n"
                        "        ip6 saddr != @clients6 tcp dport 25 drop")
        # The answer is recognised by what it quotes (the next header of the
        # packet inside the ICMPv6 message: bytes 8 + 6), whoever it is for.
        unreachable = (f'oifname "{mesh}" icmpv6 type destination-unreachable icmpv6 code port-unreachable '
                       "@th,112,8 { 4, 41 } drop")
        # Which IPv6 packets go to the tunnel. A reply is addressed to the
        # client's fips address, and the main table sends all of fd00::/8
        # into the mesh; there is no route per member to say otherwise. So
        # a connection is marked when it comes out of the tunnel, and what
        # belongs to it on the way back carries the mark that cmd_up's rule
        # reads. Anything else for a unique-local address is left to the
        # main table: a container's, a LAN's behind a fips gateway.
        replies = f"""
    chain replies {{
        type filter hook prerouting priority mangle; policy accept;
        iifname "{tun}" meta nfproto ipv6 ct mark set ct mark or {MARK}
        iifname != "{tun}" meta nfproto ipv6 ct mark and {MARK} == {MARK} meta mark set meta mark or {MARK}
    }}"""
    else:
        from4, from6 = "ip saddr != @clients4 drop", "ip6 saddr != @clients6 drop"
        members_only = ""
        replies = ""
        unreachable = (f'oifname "{mesh}" ip6 daddr @clients6 icmpv6 type destination-unreachable '
                       "icmpv6 code port-unreachable drop")
    return f"""
table inet {TABLE}
delete table inet {TABLE}
table inet {TABLE} {{
    # The inner addresses of the clients on the list. The daemon already
    # admits a packet only from the client its source address belongs to;
    # this is the same list for the rules below.
    set clients4 {{
        type ipv4_addr
        {"elements = { " + set4 + " }" if set4 else ""}
    }}
    set clients6 {{
        type ipv6_addr
        {"elements = { " + set6 + " }" if set6 else ""}
    }}

    # Destinations no client reaches (see BLOCKED_V4 above).
    set blocked4 {{
        type ipv4_addr
        flags interval
        auto-merge
        elements = {{ {", ".join(blocked4)} }}
    }}
    set blocked6 {{
        type ipv6_addr
        flags interval
        auto-merge
        elements = {{ {", ".join(blocked6)} }}
    }}

    chain forward {{
        type filter hook forward priority filter; policy accept;
        iifname "{tun}" jump from_client
        oifname "{tun}" jump to_client
    }}
    chain from_client {{
        meta nfproto ipv4 {from4}
        meta nfproto ipv6 {from6}
        # The internet only: not this host's other networks, not each other,
        # and not the uplink's own LAN or anything else that is not public.
        oifname != "{wan}" drop
        ip daddr @blocked4 drop
        ip6 daddr @blocked6 drop
        {members_only}
        meta nfproto ipv4 tcp flags syn tcp option maxseg size > {MSS4} tcp option maxseg size set {MSS4}
        meta nfproto ipv6 tcp flags syn tcp option maxseg size > {MSS6} tcp option maxseg size set {MSS6}
        accept
    }}
    chain to_client {{
        ct state != {{ established, related }} drop
        meta nfproto ipv4 tcp flags syn tcp option maxseg size > {MSS4} tcp option maxseg size set {MSS4}
        meta nfproto ipv6 tcp flags syn tcp option maxseg size > {MSS6} tcp option maxseg size set {MSS6}
        accept
    }}
    # Nothing on this host is reachable through the tunnel.
    chain input {{
        type filter hook input priority filter; policy accept;
        iifname "{tun}" drop
    }}
    # With the kernel's own tunnel module loaded, the kernel answers every
    # tunnel packet the daemon has just taken with "port unreachable",
    # because no kernel tunnel matches it. Those go nowhere.
    chain output {{
        type filter hook output priority filter; policy accept;
        {unreachable}
    }}
    chain nat {{
        type nat hook postrouting priority srcnat; policy accept;
        iifname "{tun}" oifname "{wan}" masquerade
    }}{replies}
}}
"""


UFW_TAG = "fips-exit"


def fips_firewall(clients, config, on, resolver=False):
    """Let the clients' tunnel packets through fips's own firewall.

    That firewall drops what arrives on the mesh interface unless a drop-in
    under fips.d allows it. Ours admits IP-in-IPv6 (and its fragments) and
    DNS queries (UDP port 53, for the daemon's resolver) from the clients'
    addresses, and nothing else.

    In paid mode the clients' addresses are not known here, so both are
    admitted from any node of the mesh, to this node's own address: the
    firewall is then no second lock in front of the daemon. Port 53 is
    opened only while the daemon says its resolver runs (`resolver`, from
    the answer `up` waited for), or whatever else listens there would be
    open to the mesh.
    """
    firewall = config["FIPS_FIREWALL"]
    dropin = os.path.join(os.path.dirname(firewall), "fips.d", "fips-exit.nft")
    if not firewall or not os.path.isdir(os.path.dirname(dropin)):
        return
    before = open(dropin).read() if os.path.exists(dropin) else None
    rule = None
    if on and paid(config):
        here = mesh_address(config)
        rule = ("# Written by fips-exit; do not edit.\n"
                f"ip6 daddr {here} ip6 nexthdr {{ 4, 41, 44 }} accept\n")
        if resolver:
            rule += f"ip6 daddr {here} udp dport 53 accept\n"
    elif on and clients:
        addresses = ", ".join(str(a) for a, _ in clients)
        # The tunnel, and the clients' DNS queries to the daemon's resolver.
        rule = ("# Written by fips-exit; do not edit.\n"
                f"ip6 saddr {{ {addresses} }} ip6 nexthdr {{ 4, 41, 44 }} accept\n"
                f"ip6 saddr {{ {addresses} }} udp dport 53 accept\n")
    if rule == before:
        return
    if rule is None:
        os.remove(dropin)
    else:
        open(dropin, "w").write(rule)
    # Reload only a firewall that is loaded: fips's service is optional.
    if run("nft", "list", "table", "inet", "fips", check=False).returncode == 0:
        run("nft", "-f", firewall)


def ufw(clients, config, on, resolver=False):
    """Let the tunnel through ufw, when ufw is what filters this host.

    ufw drops input and forwarding by default and has no syntax for
    "protocol 4 over IPv6", so the rules go straight into its before-chains.
    They are runtime rules: `ufw reload` drops them and `fips-exit up` puts
    them back. Forwarding is opened for the TUN device as a whole; what a
    client may actually do is decided in our own table.
    """
    def rules(tool, chain):
        listed = run(tool, "-S", chain, check=False)
        return listed.stdout.splitlines() if listed.returncode == 0 else None

    if on and paid(config):
        # From any node of the mesh, to this node's own address: see
        # fips_firewall.
        here = str(mesh_address(config))
        to_daemon = [["-i", config["MESH_IF"], "-d", here, "-p", proto, "-j", "ACCEPT"] for proto in ("4", "41")]
        if resolver:
            to_daemon.append(["-i", config["MESH_IF"], "-d", here, "-p", "udp", "--dport", "53", "-j", "ACCEPT"])
    else:
        to_daemon = [
            ["-i", config["MESH_IF"], "-s", str(a), "-p", proto, "-j", "ACCEPT"]
            for a, _ in clients for proto in ("4", "41")
        ] + [
            # DNS queries to the daemon's resolver.
            ["-i", config["MESH_IF"], "-s", str(a), "-p", "udp", "--dport", "53", "-j", "ACCEPT"]
            for a, _ in clients
        ]
    wanted = {("ip6tables", "ufw6-before-input"): to_daemon}
    for tool, chain in (("iptables", "ufw-before-forward"), ("ip6tables", "ufw6-before-forward")):
        wanted[(tool, chain)] = [["-i", config["TUN"], "-j", "ACCEPT"], ["-o", config["TUN"], "-j", "ACCEPT"]]
    for (tool, chain), specs in wanted.items():
        existing = rules(tool, chain)
        if existing is None:
            continue  # no ufw (or not this family)
        for line in existing:
            if f'--comment {UFW_TAG}' in line or f'--comment "{UFW_TAG}"' in line:
                run(tool, *line.replace("-A ", "-D ", 1).replace('"', "").split())
        if on:
            for spec in specs:
                run(tool, "-I", chain, *spec, "-m", "comment", "--comment", UFW_TAG)


def cmd_up():
    config = load_config()
    # A word that is neither must not quietly mean one of them. Said here
    # and not where the config is read: `down` reads it too, and must not
    # be stopped by it.
    if config["ACCESS"] not in ("allow-list", "paid"):
        die(f"ACCESS={config['ACCESS']} in {CONFIG}: allow-list or paid")
    clients = served(load_clients())
    wan = uplink(config)
    tun = config["TUN"]
    if not tun_present(config):
        die(f"no interface {tun}: fips-exitd is not running (systemctl start fips-exit)")
    resolver = False
    if paid(config):
        # The daemon reads ACCESS when it starts; one that was started
        # before the config said paid has no socket, and carries no member.
        stat = daemon_stat(wait=5)
        if stat is None:
            die(f"ACCESS=paid, but fips-exitd does not answer on {CONTROL}: "
                "systemctl restart fips-exit")
        resolver = stat.get("resolver") == "1"
        in_use = inner_range_in_use(config)
        if in_use:
            die(f"ACCESS=paid routes all of {INNER4} to the clients, and this host uses it: "
                + "; ".join(in_use) + ". Such a host cannot be a paid exit.")

    sysctl("net.ipv4.ip_forward", "1")
    sysctl("net.ipv6.conf.all.forwarding", "1")
    # A forwarding host stops accepting router advertisements unless told
    # otherwise, and would lose an SLAAC uplink's default route.
    accept_ra = f"/proc/sys/net/ipv6/conf/{wan}/accept_ra"
    if os.path.exists(accept_ra) and open(accept_ra).read().strip() == "1":
        sysctl(f"net.ipv6.conf.{wan}.accept_ra", "2")

    remove_kernel_tunnels(config)
    run("nft", "-f", "-", stdin=ruleset(clients, config, wan))
    fips_firewall(clients, config, True, resolver)
    ufw(clients, config, True, resolver)

    # Replies to a client's IPv6 traffic are addressed to its fips address,
    # which the main table routes into the mesh as it is. Forwarded packets
    # (never this host's own, so not the daemon's) look here first and find
    # the tunnel.
    #
    # In paid mode the members are not known here, so the routes are the
    # clients' whole ranges, and what the daemon finds no client for it
    # drops. The IPv6 one is then looked at only for packets of connections
    # that came out of the tunnel (the mark, see ruleset): for everything
    # forwarded it would take every packet to a unique-local address.
    if paid(config):
        select, routes4, routes6 = ["fwmark", f"{MARK}/{MARK}"], [str(INNER4)], [str(MESH)]
    else:
        select = ["not", "iif", "lo"]
        routes4 = [str(inner_ipv4(a)) for a, _ in clients]
        routes6 = [str(a) for a, _ in clients]
    run("ip", "-6", "rule", "del", "priority", RULE_PRIORITY, check=False)
    run("ip", "-6", "rule", "add", *select, "to", str(MESH),
        "lookup", ROUTE_TABLE, "priority", RULE_PRIORITY)
    run("ip", "-6", "route", "flush", "table", ROUTE_TABLE, check=False)
    for route in routes4:
        run("ip", "route", "replace", route, "dev", tun)
    for route in routes6:
        run("ip", "-6", "route", "replace", route, "dev", tun, "table", ROUTE_TABLE)
    # What an earlier `up` left: another client's route, or the other mode's.
    for route in json.loads(run("ip", "-j", "route", "show", "dev", tun).stdout or "[]"):
        if route.get("dst") and route["dst"] not in routes4:
            run("ip", "route", "del", route["dst"], "dev", tun)

    # The daemon re-reads the client list on SIGHUP.
    run("pkill", "-HUP", "-x", "fips-exitd", check=False)
    also = ", and the members of accounts" if paid(config) else ""
    print(f"fips-exit: up, {len(clients)} client(s){also}, uplink {wan}, tunnel {tun}")


def cmd_down():
    config = load_config()
    remove_kernel_tunnels(config)
    run("nft", "delete", "table", "inet", TABLE, check=False)
    fips_firewall([], config, False)
    ufw([], config, False)
    run("ip", "-6", "rule", "del", "priority", RULE_PRIORITY, check=False)
    run("ip", "-6", "route", "flush", "table", ROUTE_TABLE, check=False)
    if tun_present(config):
        run("ip", "route", "flush", "dev", config["TUN"], check=False)
    print("fips-exit: down (IP forwarding left as it is; the daemon is stopped by its service)")


# --- the advert ----------------------------------------------------------------
#
# An exit that wants to be found says so with one Nostr event, signed with
# its own fips key. A fips identity is a Nostr key, so the advert's author IS
# the exit: a client that reads it knows the npub to route to, and nobody
# else can advertise this exit. That is all it proves; the rest is what the
# operator says.
#
#     kind     30078  (NIP-78 application data: addressable, one per author)
#     tags     ["d", "fips-exit"], ["v", "1"], ["access", …], ["name", …],
#              ["about", …], ["country", …], …, ["expiration", <unix seconds>]
#     content  ""
#
# What the tags are and what a client makes of them is specified in
# payd/proto (src/lib.rs), and that crate and advert_tags below are held to
# one file, payd/proto/vectors/advert.json. fips2go's exit container speaks
# the same (exit-node/advert.py there, which this is a port of); its phone
# reads it (shim/src/exitfind.rs).
#
# Standard library only, like the rest of this script: the signature
# (BIP-340) and the WebSocket client are written out here.

KIND = 30078
D_TAG = "fips-exit"
VERSION = "1"
ACCESS_WORDS = ("open", "allow-list", "paid")
PAY_WORDS = ("bolt11", "onchain", "cashu", "channel")
MAX_NAME, MAX_ABOUT = 40, 200
MAX_PRICE = 10**12
MAX_MINTS, MAX_MINT_BYTES = 4, 256
MAX_PACKAGES = 8
MAX_RELAYS = 8
MAX_LIFETIME = 31 * 86400
# The timer publishes every hour; an advert is valid for three, so one missed
# hour does not drop the exit from the lists, and an exit that is gone drops
# out by itself.
ADVERT_TTL = 3 * 3600
RELAY_TIMEOUT = 10
# ISO 3166-1 alpha-2, as assigned. The same list as payd/proto's.
COUNTRIES = (
    "AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI "
    "BJ BL BM BN BO BQ BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN "
    "CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK "
    "FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM "
    "HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN "
    "KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK "
    "ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP "
    "NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW "
    "SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF "
    "TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI "
    "VN VU WF WS YE YT ZA ZM ZW"
).split()


class AdvertError(Exception):
    pass


# BIP-340 Schnorr signatures over secp256k1: the reference algorithm, as in
# the BIP. Not constant-time: it signs one public event an hour, on the
# machine the key lives on.

SECP_P = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
SECP_N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
SECP_G = (
    0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
    0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8,
)


def _tagged(tag, message):
    t = hashlib.sha256(tag.encode()).digest()
    return hashlib.sha256(t + t + message).digest()


def _add(a, b):
    if a is None:
        return b
    if b is None:
        return a
    if a[0] == b[0] and a[1] != b[1]:
        return None
    if a == b:
        slope = 3 * a[0] * a[0] * pow(2 * a[1], SECP_P - 2, SECP_P) % SECP_P
    else:
        slope = (b[1] - a[1]) * pow(b[0] - a[0], SECP_P - 2, SECP_P) % SECP_P
    x = (slope * slope - a[0] - b[0]) % SECP_P
    return x, (slope * (a[0] - x) - a[1]) % SECP_P


def _mul(point, k):
    out = None
    while k:
        if k & 1:
            out = _add(out, point)
        point = _add(point, point)
        k >>= 1
    return out


def _lift_x(x):
    if x >= SECP_P:
        return None
    c = (pow(x, 3, SECP_P) + 7) % SECP_P
    y = pow(c, (SECP_P + 1) // 4, SECP_P)
    if pow(y, 2, SECP_P) != c:
        return None
    return x, y if y % 2 == 0 else SECP_P - y


def _b32(x):
    return x.to_bytes(32, "big")


def schnorr_pubkey(seckey):
    """The 32-byte x-only public key of a 32-byte secret key."""
    d = int.from_bytes(seckey, "big")
    if len(seckey) != 32 or not 1 <= d < SECP_N:
        raise AdvertError("not a secp256k1 secret key")
    return _b32(_mul(SECP_G, d)[0])


def schnorr_verify(message, pub, sig):
    if len(message) != 32 or len(pub) != 32 or len(sig) != 64:
        return False
    point = _lift_x(int.from_bytes(pub, "big"))
    r, s = int.from_bytes(sig[:32], "big"), int.from_bytes(sig[32:], "big")
    if point is None or r >= SECP_P or s >= SECP_N:
        return False
    e = int.from_bytes(_tagged("BIP0340/challenge", sig[:32] + pub + message), "big") % SECP_N
    rr = _add(_mul(SECP_G, s), _mul(point, SECP_N - e))
    return rr is not None and rr[1] % 2 == 0 and rr[0] == r


def schnorr_sign(message, seckey, aux):
    """A BIP-340 signature of the 32-byte `message`."""
    d0 = int.from_bytes(seckey, "big")
    if len(seckey) != 32 or not 1 <= d0 < SECP_N:
        raise AdvertError("not a secp256k1 secret key")
    point = _mul(SECP_G, d0)
    d = d0 if point[1] % 2 == 0 else SECP_N - d0
    t = _b32(d ^ int.from_bytes(_tagged("BIP0340/aux", aux), "big"))
    k0 = int.from_bytes(_tagged("BIP0340/nonce", t + _b32(point[0]) + message), "big") % SECP_N
    if k0 == 0:
        raise AdvertError("nonce is zero")
    r = _mul(SECP_G, k0)
    k = k0 if r[1] % 2 == 0 else SECP_N - k0
    e = int.from_bytes(_tagged("BIP0340/challenge", _b32(r[0]) + _b32(point[0]) + message), "big") % SECP_N
    sig = _b32(r[0]) + _b32((k + e * d) % SECP_N)
    if not schnorr_verify(message, _b32(point[0]), sig):
        raise AdvertError("the signature just made does not verify")
    return sig


def read_key(path):
    """The secret key in fips's key file: an `nsec1…`, or 64 hex digits."""
    try:
        with open(path, "rb") as file:
            held = file.read(4096)
    except OSError as error:
        raise AdvertError(f"{path}: {error.strerror} "
                          f"(the node's key; FIPS_KEY in {CONFIG} if it is elsewhere)") from None
    # What was read is a secret, or near one. Whatever it is, none of it is
    # repeated: not in a message, and not in the trace of an error.
    try:
        text = held.decode("ascii").strip()
        if re.fullmatch(r"[0-9a-fA-F]{64}", text):
            return bytes.fromhex(text)
        return bech32_key(text, "nsec")
    except ValueError:
        raise AdvertError(f"{path} holds neither an nsec nor 64 hex digits") from None


# What separates words, and what is not shown or changes how what is next to
# it is shown: the two lists of payd/proto (`is_space`, `is_hidden`), by
# code point. A name must not be able to turn the line it is shown on
# round, carry what cannot be seen, or be an empty row.
SPACES = ((0x0009, 0x000D), (0x0020, 0x0020), (0x0085, 0x0085), (0x00A0, 0x00A0), (0x1680, 0x1680),
          (0x2000, 0x200A), (0x2028, 0x2029), (0x202F, 0x202F), (0x205F, 0x205F), (0x3000, 0x3000))
HIDDEN = ((0x0000, 0x001F), (0x007F, 0x009F), (0x00AD, 0x00AD), (0x061C, 0x061C), (0x180E, 0x180E),
          (0x200B, 0x200B), (0x200E, 0x200F), (0x202A, 0x202E), (0x2060, 0x206F), (0xFEFF, 0xFEFF),
          (0xFFF9, 0xFFFB), (0xE0000, 0xE007F), (0x115F, 0x1160), (0x2800, 0x2800), (0x3164, 0x3164),
          (0xFFA0, 0xFFA0))


def _among(c, ranges):
    return any(low <= ord(c) <= high for low, high in ranges)


def tidy(text, limit):
    """`text` as a reader of an advert shows it: one line of words with
    single spaces between them, nothing hidden, `limit` characters at most."""
    spaced = "".join(" " if _among(c, SPACES) else c for c in text)
    words = "".join(c for c in spaced if not _among(c, HIDDEN)).split(" ")
    return " ".join(word for word in words if word)[:limit].rstrip(" ")


def text_in_order(text, limit):
    """Is `text` what an advert may carry as a name or a note: already what
    a reader would show? A reader cuts and tidies what it is given; the exit
    is told here instead."""
    return tidy(text, limit) == text


def _whole(value, low, high):
    return isinstance(value, int) and not isinstance(value, bool) and low <= value <= high


def _mint_in_order(url):
    rest = url[8:] if url.startswith("https://") else url[7:] if url.startswith("http://") else ""
    in_an_address = re.fullmatch(r"[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]+", rest) is not None
    return len(url.encode()) <= MAX_MINT_BYTES and in_an_address


def advert_tags(advert, now):
    """The tags of an advert as written at `now`, in the one order every
    publisher writes them, or AdvertError for an advert no client would
    list. `advert` is as payd/proto/vectors/advert.json writes one: access,
    name, about, optionally country, expires, and terms, which is None
    unless the access is paid."""
    access, terms = advert["access"], advert.get("terms")
    if access not in ACCESS_WORDS:
        raise AdvertError(f"access is one of {', '.join(ACCESS_WORDS)}")
    if not now < advert["expires"] <= now + MAX_LIFETIME:
        raise AdvertError("the advert is over already, or valid for more than 31 days")
    if not text_in_order(advert["name"], MAX_NAME):
        raise AdvertError(f"the name is one line of at most {MAX_NAME} characters")
    if not text_in_order(advert["about"], MAX_ABOUT):
        raise AdvertError(f"the note is one line of at most {MAX_ABOUT} characters")
    country = advert.get("country")
    if country is not None and country not in COUNTRIES:
        raise AdvertError(f"{country!r} is not a country: two capital letters, ISO 3166-1 (DE, IS, US, …)")
    if (terms is not None) != (access == "paid"):
        raise AdvertError("terms go with access paid, and only with it")
    tags = [["d", D_TAG], ["v", VERSION], ["access", access]]
    if advert["name"]:
        tags.append(["name", advert["name"]])
    if advert["about"]:
        tags.append(["about", advert["about"]])
    if country is not None:
        tags.append(["country", country])
    if terms is not None:
        methods, mints, packages = terms["methods"], terms["mints"], terms["packages"]
        ids = [package["id"] for package in packages]
        in_order = (
            _whole(terms["price_msat_per_gb"], 1, MAX_PRICE)
            and methods and all(m in PAY_WORDS for m in methods) and len(set(methods)) == len(methods)
            and _whole(terms["port"], 1, 65535)
            and len(mints) <= MAX_MINTS and all(_mint_in_order(m) for m in mints) and len(set(mints)) == len(mints)
            and len(packages) <= MAX_PACKAGES and len(set(ids)) == len(ids)
            and all(re.fullmatch(r"[A-Za-z0-9._-]{1,20}", package["id"])
                    and _whole(package["bytes"], 1, 10**15) and _whole(package["sat"], 1, 10**11)
                    and _whole(package["days"], 1, 3660) for package in packages)
        )
        if not in_order:
            raise AdvertError("the terms are out of bounds (payd/proto/src/lib.rs has them)")
        tags.append(["price", str(terms["price_msat_per_gb"])])
        tags.append(["pay", *methods])
        tags.append(["port", str(terms["port"])])
        tags += [["mint", mint] for mint in mints]
        tags += [["package", p["id"], str(p["bytes"]), str(p["sat"]), str(p["days"])] for p in packages]
    tags.append(["expiration", str(advert["expires"])])
    return tags


def build_event(seckey, tags, now, aux=None):
    """The signed event (NIP-01), as a dict ready for `["EVENT", …]`."""
    pub = schnorr_pubkey(seckey).hex()
    body = json.dumps([0, pub, now, KIND, tags, ""], separators=(",", ":"), ensure_ascii=False)
    event_id = hashlib.sha256(body.encode()).digest()
    sig = schnorr_sign(event_id, seckey, os.urandom(32) if aux is None else aux)
    return {"id": event_id.hex(), "pubkey": pub, "created_at": now, "kind": KIND,
            "tags": tags, "content": "", "sig": sig.hex()}


def parse_relay(url):
    """(tls, host, port, path) of a relay URL. A relay on the mesh is
    `ws://<npub>.fips`: plain `ws`, since fips already encrypts."""
    found = re.fullmatch(r"(wss?)://([A-Za-z0-9.-]{1,253})(?::(\d{1,5}))?(/[!-~]*)?", url.strip())
    if not found:
        raise AdvertError(f"not a relay URL (ws:// or wss://): {url!r}")
    tls, host = found.group(1) == "wss", found.group(2).lower()
    # A name as the resolver takes one: it must not be the resolver that
    # says so, with an error of its own.
    if not all(re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", label) for label in host.split(".")):
        raise AdvertError(f"not a host name in {url!r}")
    port = int(found.group(3) or (443 if tls else 80))
    if not 1 <= port <= 65535:
        raise AdvertError(f"port out of range in {url!r}")
    if host.endswith(".fips"):
        try:
            bech32_key(host[: -len(".fips")], "npub")
        except ValueError:
            raise AdvertError(f"a relay on the mesh is ws://<npub>.fips: {url!r}") from None
        if tls:
            raise AdvertError(f"a relay on the mesh is ws://, not wss://: {url!r}")
    return tls, host, port, found.group(4) or "/"


def parse_relays(text):
    urls = text.replace(",", " ").split()
    if not urls:
        raise AdvertError("ADVERT_RELAYS is empty: name at least one relay to publish to")
    if len(urls) > MAX_RELAYS:
        raise AdvertError(f"ADVERT_RELAYS: at most {MAX_RELAYS} relays")
    for url in urls:
        parse_relay(url)
    return urls


def _receive(sock, n, deadline):
    """Exactly `n` bytes, all of them before `deadline`: a relay that sends
    a byte now and then is not waited for any longer than one that sends
    nothing."""
    data = b""
    while len(data) < n:
        left = deadline - time.monotonic()
        if left <= 0:
            raise AdvertError("the relay did not answer in time")
        sock.settimeout(left)
        try:
            chunk = sock.recv(n - len(data))
        except TimeoutError:
            raise AdvertError("the relay did not answer in time") from None
        if not chunk:
            raise AdvertError("the relay closed the connection")
        data += chunk
    return data


def _send_frame(sock, opcode, payload):
    """One masked, unfragmented client frame."""
    head = bytes([0x80 | opcode])
    n = len(payload)
    if n < 126:
        head += bytes([0x80 | n])
    elif n < 65536:
        head += bytes([0x80 | 126]) + struct.pack(">H", n)
    else:
        head += bytes([0x80 | 127]) + struct.pack(">Q", n)
    mask = os.urandom(4)
    sock.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))


def _receive_message(sock, deadline):
    """The next text message, in one frame or in several, answering pings
    and skipping the rest. What a relay sends is a stranger's: every length
    is bounded, and so is the time (`deadline`)."""
    parts, size = None, 0
    while True:
        first, second = _receive(sock, 2, deadline)
        n = second & 0x7F
        if n == 126:
            (n,) = struct.unpack(">H", _receive(sock, 2, deadline))
        elif n == 127:
            (n,) = struct.unpack(">Q", _receive(sock, 8, deadline))
        size += n
        if size > 65536:
            raise AdvertError("the relay sent an oversized frame")
        mask = _receive(sock, 4, deadline) if second & 0x80 else None
        payload = _receive(sock, n, deadline)
        if mask:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        opcode, last = first & 0x0F, first & 0x80
        if opcode == 0x8:
            raise AdvertError("the relay closed the connection")
        if opcode == 0x9:
            _send_frame(sock, 0xA, payload)
        if opcode >= 0x8:
            size -= n  # a control frame may come between the parts of a message
            continue
        if opcode == 0x1:
            parts = [payload]
        elif opcode == 0x0 and parts is not None:
            parts.append(payload)
        else:
            parts = None  # not text, or the rest of something that was not
        if parts is None or last:
            if parts is not None:
                return b"".join(parts).decode("utf-8", "replace")
            size = 0


def shown(text, limit):
    """A relay's words, as they may be printed: cut, and with nothing that
    would do something to the terminal or the journal they are printed to."""
    return "".join(c if c.isprintable() else "?" for c in str(text)[:limit])


def publish(event, url, timeout=RELAY_TIMEOUT):
    """Send `event` to one relay and return what it said ("" for accepted
    with no remark). AdvertError when it was not accepted. The relay has
    `timeout` seconds to be reached and as long again for everything else.

    A relay on the mesh is reached by its name, through the host's own
    resolver: asking fips for `<npub>.fips` is also what tells fips whose
    address it is, without which it could not route there."""
    tls, host, port, path = parse_relay(url)
    sock = socket.create_connection((host, port), timeout=timeout)
    deadline = time.monotonic() + timeout
    try:
        if tls:
            sock = ssl.create_default_context().wrap_socket(sock, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode()
        named = host if port == (443 if tls else 80) else f"{host}:{port}"
        sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {named}\r\nUpgrade: websocket\r\n"
                      f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                      "Sec-WebSocket-Version: 13\r\nUser-Agent: fips-exit\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            if len(head) > 8192:
                raise AdvertError("the relay's answer is not a WebSocket upgrade")
            head += _receive(sock, 1, deadline)
        status = head.split(b"\r\n", 1)[0].decode("latin-1")
        if " 101" not in status:
            raise AdvertError(f"the relay refused the WebSocket: {shown(status, 80)}")
        _send_frame(sock, 0x1, json.dumps(["EVENT", event], separators=(",", ":"), ensure_ascii=False).encode())
        while True:  # until the deadline, which _receive keeps
            try:
                answer = json.loads(_receive_message(sock, deadline))
            except (ValueError, RecursionError):
                continue  # not JSON, or JSON nested deeper than Python will follow
            if isinstance(answer, list) and len(answer) >= 3 and answer[0] == "OK" and answer[1] == event["id"]:
                remark = shown(answer[3], 120) if len(answer) > 3 else ""
                if answer[2] is True:
                    return remark
                raise AdvertError(f"the relay rejected the advert: {remark}")
    finally:
        try:
            sock.close()
        except OSError:
            pass


def cmd_advert(what="publish"):
    """Publish this exit's advert to the relays in ADVERT_RELAYS, or with
    `show` print the event without sending it anywhere."""
    if what not in ("publish", "show"):
        raise TypeError(what)
    config = load_config()
    relays = config.get("ADVERT_RELAYS", "")
    if what == "publish" and not relays.strip():
        # Not an error: the timer may run on an exit that does not advertise.
        print(f"fips-exit: no advert: ADVERT_RELAYS is not set in {CONFIG}")
        return
    if what == "publish" and not tun_present(config):
        # Before anything is read that a stopped exit may not have: its
        # mesh interface, for one. The timer finds this every hour then.
        print("fips-exit: no advert: the exit is not running")
        return
    key_path = config.get("FIPS_KEY") or "/etc/fips/fips.key"
    try:
        urls = parse_relays(relays) if what == "publish" else []
        key = read_key(key_path)
        # The advert's author is the exit. A key that is not this node's
        # (fips was given another identity since, or keeps none on disk)
        # would advertise somebody else, or nobody.
        here, signer = mesh_address(config), key_address(schnorr_pubkey(key))
        if signer != here:
            raise AdvertError(f"the key in {key_path} is not this node's: it is {signer}'s, "
                              f"and {config['MESH_IF']} has {here}")
        now = int(time.time())
        # allow-list in both modes, for now: with ACCESS=paid nothing here
        # takes a payment yet, so who is served is still who the operator
        # put there, on the list or in an account.
        tags = advert_tags({
            "access": "allow-list",
            "name": " ".join(config.get("ADVERT_NAME", "").split()),
            "about": " ".join(config.get("ADVERT_ABOUT", "").split()),
            "country": config.get("COUNTRY") or None,
            "expires": now + ADVERT_TTL,
            "terms": None,
        }, now)
        event = build_event(key, tags, now)
    except AdvertError as error:
        die(str(error))
    if what == "show":
        print(json.dumps(event, ensure_ascii=False))
        return
    accepted = 0
    for url in urls:
        try:
            remark = publish(event, url)
            accepted += 1
            print(f"{url}: accepted" + (f" ({remark})" if remark else ""))
        except Exception as error:  # whatever one relay does, the next is still tried
            print(f"{url}: {shown(error, 160)}")
    if not accepted:
        die("no relay took the advert")



def cmd_add(who, name=""):
    address = parse_client(who)
    clients = load_clients()
    for other, other_name in clients:
        if other == address:
            die(f"{address} is already a client")
        # 22 bits of the address: a clash is unlikely, and must not pass.
        if inner_ipv4(other) == inner_ipv4(address):
            die(f"{address} clashes with client {other} {other_name} (same derived IPv4 address)")
    clients.append((address, name))
    save_clients(clients)
    print(f"added {address} (IPv4 {inner_ipv4(address)})")
    apply()


def cmd_remove(who):
    clients = load_clients()
    keep = [(a, n) for a, n in clients if n != who] if any(n == who for _, n in clients) else None
    if keep is None:
        address = parse_client(who)
        keep = [(a, n) for a, n in clients if a != address]
    if len(keep) == len(clients):
        die(f"{who} is not a client")
    save_clients(keep)
    apply()


def cmd_list():
    clients = load_clients()
    serving = {address for address, _ in served(clients, warn=False)}
    for address, name in clients:
        note = "" if address in serving else "  (not served: its IPv4 address is taken)"
        print(f"{address}  {inner_ipv4(address)}  {name}".rstrip() + note)


def apply():
    """After a change to the list: apply it now if the daemon runs, and say
    so if it does not (the list is saved either way).

    The daemon is told first and by itself. It is what admits a client, so
    a client that was removed is cut off even when the rest of `up` then
    stops at something: a host it refuses, a daemon without its socket."""
    if tun_present(load_config()):
        run("pkill", "-HUP", "-x", "fips-exitd", check=False)
        cmd_up()
    else:
        print("fips-exit: saved; fips-exitd is not running, so nothing was applied "
              "(systemctl start fips-exit)")


def cmd_status():
    config = load_config()
    daemon = run("pgrep", "-x", "fips-exitd", check=False).returncode == 0
    print("daemon fips-exitd: " + ("running" if daemon else "not running"))
    table = run("nft", "list", "table", "inet", TABLE, check=False)
    print("nftables table: " + ("present" if table.returncode == 0 else "absent"))
    if tun_present(config):
        stats = json.loads(run("ip", "-j", "-s", "link", "show", config["TUN"]).stdout)[0]["stats64"]
        # The TUN's point of view: what it receives came from the clients.
        print(f"{config['TUN']}: {stats['rx']['packets']} packets from clients, "
              f"{stats['tx']['packets']} to clients")
    print(f"clients: {len(load_clients())}")
    if paid(config):
        stat = daemon_stat()
        print("access: paid, " + (f"{stat.get('accounts', '?')} account(s)" if stat
                                  else f"but the daemon does not answer on {CONTROL}"))


def cmd_accounts():
    """The accounts the daemon holds: what each may use and has used."""
    if not paid(load_config()):
        die(f"no accounts: ACCESS is not paid in {CONFIG}")
    answer = control("usage", wait=2)
    if not answer or not answer[-1].startswith("ok"):
        die(f"no answer from fips-exitd on {CONTROL}" + (f": {answer[-1]}" if answer else ""))
    rows = [line.split()[1:] for line in answer[:-1] if line.startswith("account ")]
    print(f"{'account':<32} {'granted':>15} {'from members':>15} {'to members':>15} {'left':>15}")
    for name, granted, used_in, used_out in rows:
        left = max(0, int(granted) - int(used_in) - int(used_out))
        print(f"{name:<32} {granted:>15} {used_in:>15} {used_out:>15} {left:>15}")
    if not rows:
        print("(none)")


def main(argv):
    commands = {"up": cmd_up, "down": cmd_down, "add": cmd_add, "remove": cmd_remove,
                "list": cmd_list, "status": cmd_status, "accounts": cmd_accounts, "advert": cmd_advert}
    if len(argv) < 2 or argv[1] not in commands:
        sys.exit(__doc__)
    try:
        commands[argv[1]](*argv[2:])
    except TypeError:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
