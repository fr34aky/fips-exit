#!/usr/bin/env python3
"""fips-exit: turn a Linux fips node into an exit node.

Clients (fips2go, or any fips node) send their internet traffic to this node
as plain IP-in-IPv6 over the mesh (RFC 2473: next-header 4 for IPv4, 41 for
IPv6, no tunnel header, no encryption of its own - fips encrypts end to
end). The daemon fips-exitd moves those packets between the mesh and a TUN
device; this script is everything around it: the client list, the routes,
NAT to the uplink, and the firewall.

  fips-exit add <npub|fd-address> [name]   allow a client (and apply)
  fips-exit remove <npub|fd-address|name>  remove a client (and apply)
  fips-exit list                           the clients and their addresses
  fips-exit up                             apply the client list (needs fips-exitd running)
  fips-exit down                           remove everything this script made
  fips-exit status                         what is in place right now

Needs root, iproute2, nftables, and fips-exitd (systemctl start fips-exit).
"""

import hashlib
import ipaddress
import json
import os
import subprocess
import sys

DIR = os.environ.get("FIPS_EXIT_DIR", "/etc/fips-exit")
CLIENTS = os.path.join(DIR, "clients")
CONFIG = os.path.join(DIR, "config")

TABLE = "fips_exit"  # nftables table (inet)
ROUTE_TABLE = "5170"  # per-client IPv6 return routes
RULE_PRIORITY = "5170"
MESH = ipaddress.ip_network("fd00::/8")

# A mesh packet is at most 1280 bytes, so an inner packet beside the 40-byte
# outer header travels whole up to 1240 and as two fragments above that. TCP
# is kept whole by its MSS.
INNER_WHOLE = 1240
MSS4 = INNER_WHOLE - 40
MSS6 = INNER_WHOLE - 60


def die(message):
    sys.exit(f"fips-exit: {message}")


def run(*argv, check=True, stdin=None):
    done = subprocess.run(argv, input=stdin, capture_output=True, text=True)
    if check and done.returncode != 0:
        die(f"{' '.join(argv)}: {done.stderr.strip() or done.stdout.strip()}")
    return done


# --- addresses ---------------------------------------------------------------

BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def bech32_polymod(values):
    generator = [0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3]
    chk = 1
    for value in values:
        top = chk >> 25
        chk = (chk & 0x1FFFFFF) << 5 ^ value
        for i in range(5):
            chk ^= generator[i] if (top >> i) & 1 else 0
    return chk


def npub_to_address(npub):
    """The fips address of a public key: fd + the first 15 bytes of
    sha256(x-only key), as fips derives it."""
    npub = npub.strip().lower()
    if not npub.startswith("npub1") or any(c not in BECH32 for c in npub[5:]):
        raise ValueError("not an npub")
    data = [BECH32.index(c) for c in npub[5:]]
    expanded = [ord(c) >> 5 for c in "npub"] + [0] + [ord(c) & 31 for c in "npub"]
    if bech32_polymod(expanded + data) != 1:
        raise ValueError("npub checksum mismatch (mistyped?)")
    acc = bits = 0
    key = bytearray()
    for value in data[:-6]:
        acc = (acc << 5) | value
        bits += 5
        if bits >= 8:
            bits -= 8
            key.append((acc >> bits) & 0xFF)
    if len(key) != 32:
        raise ValueError("npub is not a 32-byte key")
    digest = hashlib.sha256(bytes(key)).digest()
    return ipaddress.IPv6Address(b"\xfd" + digest[:15])


def parse_client(text):
    """An npub or an fd address, as the client's fips address."""
    try:
        address = npub_to_address(text) if text.startswith("npub1") else ipaddress.IPv6Address(text)
    except ValueError as error:
        die(f"{text}: {error}")
    if address not in MESH:
        die(f"{address} is not a fips address (fd00::/8)")
    return address


def inner_ipv4(address):
    """The client's IPv4 address inside the tunnel: 100.64.0.0/10 with the
    low 22 bits of the three bytes after the fd of its fips address. The
    client derives the same value; fips-exitd (src/main.rs) and fips2go
    (shim/src/exit.rs) must agree with this, byte for byte."""
    a = address.packed
    bits = (a[1] << 16 | a[2] << 8 | a[3]) & 0x3FFFFF
    return ipaddress.IPv4Address(0x64400000 | bits)


# --- state -------------------------------------------------------------------


def load_clients():
    """[(address, name)] from the client list."""
    clients = []
    try:
        lines = open(CLIENTS).read().splitlines()
    except FileNotFoundError:
        return clients
    for line in lines:
        fields = line.split("#")[0].split()
        if fields:
            clients.append((ipaddress.IPv6Address(fields[0]), " ".join(fields[1:])))
    return clients


# Where a client may never be sent, whatever its packet says: this host's
# and the uplink's own networks, the other clients, and everything that is
# not the public internet. The uplink interface is usually the LAN as well,
# so "out of the uplink" alone lets a client reach the operator's router,
# NAS and printer. The same list as fips2go's exit container
# (exit-node/exitctl.py, BLOCKED_V4), plus its IPv6 counterpart, since this
# exit forwards IPv6 too.
BLOCKED_V4 = [
    "0.0.0.0/8",        # "this network"
    "10.0.0.0/8",       # private
    "100.64.0.0/10",    # carrier-grade NAT: the clients' own inner addresses
    "127.0.0.0/8",      # loopback
    "169.254.0.0/16",   # link-local
    "172.16.0.0/12",    # private
    "192.0.0.0/24",     # IETF protocol assignments
    "192.0.2.0/24",     # documentation
    "192.168.0.0/16",   # private
    "198.18.0.0/15",    # benchmarking
    "198.51.100.0/24",  # documentation
    "203.0.113.0/24",   # documentation
    "224.0.0.0/3",      # multicast, reserved, broadcast
]
BLOCKED_V6 = [
    # All of 0000::/8, which IANA reserves: unspecified, loopback,
    # IPv4-mapped and -compatible, and both NAT64 prefixes (64:ff9b::/96 and
    # 64:ff9b:1::/48). A NAT64 gateway on the uplink's network would turn
    # 64:ff9b::c0a8:101 into 192.168.1.1, so the prefix is a way round the
    # IPv4 list. The cost: an exit whose uplink is IPv6-only behind NAT64
    # cannot carry its clients' IPv6 connections to IPv4-only sites.
    "::/8",
    "100::/64",         # discard-only
    "2001::/32",        # Teredo
    "2001:db8::/32",    # documentation
    "2002::/16",        # 6to4: can carry a private IPv4 address inside
    "3fff::/20",        # documentation
    "fc00::/7",         # unique local, which includes the mesh (fd00::/8)
    "fe80::/10",        # link-local
    "fec0::/10",        # site-local (deprecated)
    "ff00::/8",         # multicast
]


def blocked(config):
    """(IPv4 networks, IPv6 networks) no client is forwarded to: the lists
    above and BLOCK_CIDRS from the config, which only ever adds. A value
    there that is not a network stops the script: a block the operator
    asked for and did not get would be silent."""
    v4, v6 = list(BLOCKED_V4), list(BLOCKED_V6)
    for text in config.get("BLOCK_CIDRS", "").replace(",", " ").split():
        try:
            network = ipaddress.ip_network(text, strict=False)
        except ValueError as error:
            die(f"BLOCK_CIDRS: {text}: {error}")
        (v4 if network.version == 4 else v6).append(str(network))
    return v4, v6


def served(clients, warn=True):
    """The clients the exit serves: the list, without any whose derived IPv4
    address an earlier line already has. `add` never writes such a line; a
    list edited by hand can hold one, and the daemon skips it the same way
    (the first keeps the address), so the routes and the firewall must not
    be built for it either."""
    out, by_inner = [], {}
    for address, name in clients:
        inner = inner_ipv4(address)
        other = by_inner.get(inner)
        if other is not None and other != address:
            if warn:
                print(f"fips-exit: {address} {name} has the same IPv4 address ({inner}) as "
                      f"{other}; not served. Remove one of them.", file=sys.stderr)
            continue
        if other is None:
            by_inner[inner] = address
            out.append((address, name))
    return out


def save_clients(clients):
    os.makedirs(DIR, exist_ok=True)
    temp = CLIENTS + ".tmp"
    with open(temp, "w") as out:
        out.write("# fips-exit clients: <fips address> [name]. Edit with fips-exit add/remove.\n")
        for address, name in clients:
            out.write(f"{address} {name}".rstrip() + "\n")
    os.replace(temp, CLIENTS)


def load_config():
    # TUN: the daemon's device. FIPS_FIREWALL: fips's own nftables file
    # (default-deny input on its TUN); empty = leave it alone.
    config = {"MESH_IF": "fips0", "WAN": "", "TUN": "fipsexit0",
              "FIPS_FIREWALL": "/etc/fips/fips.nft"}
    try:
        for line in open(CONFIG):
            key, _, value = line.split("#")[0].partition("=")
            if key.strip():
                config[key.strip()] = value.strip().strip('"')
    except FileNotFoundError:
        pass
    return config


def uplink(config):
    if config["WAN"]:
        return config["WAN"]
    for family in ("-4", "-6"):
        routes = json.loads(run("ip", "-j", family, "route", "show", "default").stdout or "[]")
        for route in routes:
            if route.get("dev"):
                return route["dev"]
    die(f"no default route; set WAN=<interface> in {CONFIG}")


def mesh_address(config):
    shown = run("ip", "-j", "-6", "addr", "show", "dev", config["MESH_IF"], check=False)
    if shown.returncode != 0:
        die(f"no interface {config['MESH_IF']}: is fips running? (MESH_IF in {CONFIG})")
    for interface in json.loads(shown.stdout or "[]"):
        for info in interface.get("addr_info", []):
            address = ipaddress.IPv6Address(info["local"])
            if address in MESH:
                return address
    die(f"{config['MESH_IF']} has no fips address")


def tun_present(config):
    return run("ip", "link", "show", "dev", config["TUN"], check=False).returncode == 0


def remove_kernel_tunnels(config):
    """Undo what versions before the daemon set up: one ip6tnl device per
    client (fx…) and a DF-clearing tc filter on the uplink."""
    links = json.loads(run("ip", "-j", "link", "show", "type", "ip6tnl").stdout or "[]")
    for link in links:
        if link["ifname"].startswith("fx"):
            run("ip", "link", "del", link["ifname"])
    wan = config["WAN"] or None
    if wan is None:
        routes = json.loads(run("ip", "-j", "route", "show", "default").stdout or "[]")
        wan = next((r["dev"] for r in routes if r.get("dev")), None)
    if wan:
        run("tc", "filter", "del", "dev", wan, "ingress", "pref", "5170", check=False)


# --- up / down ---------------------------------------------------------------


def sysctl(key, value):
    path = "/proc/sys/" + key.replace(".", "/")
    try:
        if open(path).read().strip() != value:
            open(path, "w").write(value)
    except OSError as error:
        die(f"sysctl {key}={value}: {error}")


def ruleset(clients, config, wan):
    """The whole nftables table, replaced in one transaction."""
    tun, mesh = config["TUN"], config["MESH_IF"]
    set4 = ", ".join(str(inner_ipv4(a)) for a, _ in clients)
    set6 = ", ".join(str(a) for a, _ in clients)
    blocked4, blocked6 = blocked(config)
    return f"""
table inet {TABLE}
delete table inet {TABLE}
table inet {TABLE} {{
    # The clients' inner addresses. The daemon already admits a packet only
    # from the client its source address belongs to; this is the same list
    # for the rules below.
    set clients4 {{
        type ipv4_addr
        {"elements = { " + set4 + " }" if set4 else ""}
    }}
    set clients6 {{
        type ipv6_addr
        {"elements = { " + set6 + " }" if set6 else ""}
    }}

    # Destinations no client reaches (see BLOCKED_V4 above).
    set blocked4 {{
        type ipv4_addr
        flags interval
        auto-merge
        elements = {{ {", ".join(blocked4)} }}
    }}
    set blocked6 {{
        type ipv6_addr
        flags interval
        auto-merge
        elements = {{ {", ".join(blocked6)} }}
    }}

    chain forward {{
        type filter hook forward priority filter; policy accept;
        iifname "{tun}" jump from_client
        oifname "{tun}" jump to_client
    }}
    chain from_client {{
        meta nfproto ipv4 ip saddr != @clients4 drop
        meta nfproto ipv6 ip6 saddr != @clients6 drop
        # The internet only: not this host's other networks, not each other,
        # and not the uplink's own LAN or anything else that is not public.
        oifname != "{wan}" drop
        ip daddr @blocked4 drop
        ip6 daddr @blocked6 drop
        meta nfproto ipv4 tcp flags syn tcp option maxseg size > {MSS4} tcp option maxseg size set {MSS4}
        meta nfproto ipv6 tcp flags syn tcp option maxseg size > {MSS6} tcp option maxseg size set {MSS6}
        accept
    }}
    chain to_client {{
        ct state != {{ established, related }} drop
        meta nfproto ipv4 tcp flags syn tcp option maxseg size > {MSS4} tcp option maxseg size set {MSS4}
        meta nfproto ipv6 tcp flags syn tcp option maxseg size > {MSS6} tcp option maxseg size set {MSS6}
        accept
    }}
    # Nothing on this host is reachable through the tunnel.
    chain input {{
        type filter hook input priority filter; policy accept;
        iifname "{tun}" drop
    }}
    # With the kernel's own tunnel module loaded, the kernel answers every
    # tunnel packet the daemon has just taken with "port unreachable",
    # because no kernel tunnel matches it. Those go nowhere.
    chain output {{
        type filter hook output priority filter; policy accept;
        oifname "{mesh}" ip6 daddr @clients6 icmpv6 type destination-unreachable icmpv6 code port-unreachable drop
    }}
    chain nat {{
        type nat hook postrouting priority srcnat; policy accept;
        iifname "{tun}" oifname "{wan}" masquerade
    }}
}}
"""


UFW_TAG = "fips-exit"


def fips_firewall(clients, config, on):
    """Let the clients' tunnel packets through fips's own firewall.

    That firewall drops what arrives on the mesh interface unless a drop-in
    under fips.d allows it. Ours admits IP-in-IPv6 (and its fragments) and
    DNS queries (UDP port 53, for the daemon's resolver) from the clients'
    addresses, and nothing else.
    """
    firewall = config["FIPS_FIREWALL"]
    dropin = os.path.join(os.path.dirname(firewall), "fips.d", "fips-exit.nft")
    if not firewall or not os.path.isdir(os.path.dirname(dropin)):
        return
    before = open(dropin).read() if os.path.exists(dropin) else None
    rule = None
    if on and clients:
        addresses = ", ".join(str(a) for a, _ in clients)
        # The tunnel, and the clients' DNS queries to the daemon's resolver.
        rule = ("# Written by fips-exit; do not edit.\n"
                f"ip6 saddr {{ {addresses} }} ip6 nexthdr {{ 4, 41, 44 }} accept\n"
                f"ip6 saddr {{ {addresses} }} udp dport 53 accept\n")
    if rule == before:
        return
    if rule is None:
        os.remove(dropin)
    else:
        open(dropin, "w").write(rule)
    # Reload only a firewall that is loaded: fips's service is optional.
    if run("nft", "list", "table", "inet", "fips", check=False).returncode == 0:
        run("nft", "-f", firewall)


def ufw(clients, config, on):
    """Let the tunnel through ufw, when ufw is what filters this host.

    ufw drops input and forwarding by default and has no syntax for
    "protocol 4 over IPv6", so the rules go straight into its before-chains.
    They are runtime rules: `ufw reload` drops them and `fips-exit up` puts
    them back. Forwarding is opened for the TUN device as a whole; what a
    client may actually do is decided in our own table.
    """
    def rules(tool, chain):
        listed = run(tool, "-S", chain, check=False)
        return listed.stdout.splitlines() if listed.returncode == 0 else None

    wanted = {
        ("ip6tables", "ufw6-before-input"): [
            ["-i", config["MESH_IF"], "-s", str(a), "-p", proto, "-j", "ACCEPT"]
            for a, _ in clients for proto in ("4", "41")
        ] + [
            # DNS queries to the daemon's resolver.
            ["-i", config["MESH_IF"], "-s", str(a), "-p", "udp", "--dport", "53", "-j", "ACCEPT"]
            for a, _ in clients
        ],
    }
    for tool, chain in (("iptables", "ufw-before-forward"), ("ip6tables", "ufw6-before-forward")):
        wanted[(tool, chain)] = [["-i", config["TUN"], "-j", "ACCEPT"], ["-o", config["TUN"], "-j", "ACCEPT"]]
    for (tool, chain), specs in wanted.items():
        existing = rules(tool, chain)
        if existing is None:
            continue  # no ufw (or not this family)
        for line in existing:
            if f'--comment {UFW_TAG}' in line or f'--comment "{UFW_TAG}"' in line:
                run(tool, *line.replace("-A ", "-D ", 1).replace('"', "").split())
        if on:
            for spec in specs:
                run(tool, "-I", chain, *spec, "-m", "comment", "--comment", UFW_TAG)


def cmd_up():
    config = load_config()
    clients = served(load_clients())
    wan = uplink(config)
    tun = config["TUN"]
    if not tun_present(config):
        die(f"no interface {tun}: fips-exitd is not running (systemctl start fips-exit)")

    sysctl("net.ipv4.ip_forward", "1")
    sysctl("net.ipv6.conf.all.forwarding", "1")
    # A forwarding host stops accepting router advertisements unless told
    # otherwise, and would lose an SLAAC uplink's default route.
    accept_ra = f"/proc/sys/net/ipv6/conf/{wan}/accept_ra"
    if os.path.exists(accept_ra) and open(accept_ra).read().strip() == "1":
        sysctl(f"net.ipv6.conf.{wan}.accept_ra", "2")

    remove_kernel_tunnels(config)
    run("nft", "-f", "-", stdin=ruleset(clients, config, wan))
    fips_firewall(clients, config, True)
    ufw(clients, config, True)

    # Replies to a client's IPv6 traffic are addressed to its fips address,
    # which the main table routes into the mesh as it is. Forwarded packets
    # (never this host's own, so not the daemon's) look here first and find
    # the tunnel.
    run("ip", "-6", "rule", "del", "priority", RULE_PRIORITY, check=False)
    run("ip", "-6", "rule", "add", "not", "iif", "lo", "to", str(MESH),
        "lookup", ROUTE_TABLE, "priority", RULE_PRIORITY)
    run("ip", "-6", "route", "flush", "table", ROUTE_TABLE, check=False)
    wanted4 = {str(inner_ipv4(a)) for a, _ in clients}
    for route in json.loads(run("ip", "-j", "route", "show", "dev", tun).stdout or "[]"):
        if route["dst"] not in wanted4:
            run("ip", "route", "del", route["dst"], "dev", tun)
    for address, _ in clients:
        run("ip", "route", "replace", str(inner_ipv4(address)), "dev", tun)
        run("ip", "-6", "route", "replace", str(address), "dev", tun, "table", ROUTE_TABLE)

    # The daemon re-reads the client list on SIGHUP.
    run("pkill", "-HUP", "-x", "fips-exitd", check=False)
    print(f"fips-exit: up, {len(clients)} client(s), uplink {wan}, tunnel {tun}")


def cmd_down():
    config = load_config()
    remove_kernel_tunnels(config)
    run("nft", "delete", "table", "inet", TABLE, check=False)
    fips_firewall([], config, False)
    ufw([], config, False)
    run("ip", "-6", "rule", "del", "priority", RULE_PRIORITY, check=False)
    run("ip", "-6", "route", "flush", "table", ROUTE_TABLE, check=False)
    if tun_present(config):
        run("ip", "route", "flush", "dev", config["TUN"], check=False)
    print("fips-exit: down (IP forwarding left as it is; the daemon is stopped by its service)")


def cmd_add(who, name=""):
    address = parse_client(who)
    clients = load_clients()
    for other, other_name in clients:
        if other == address:
            die(f"{address} is already a client")
        # 22 bits of the address: a clash is unlikely, and must not pass.
        if inner_ipv4(other) == inner_ipv4(address):
            die(f"{address} clashes with client {other} {other_name} (same derived IPv4 address)")
    clients.append((address, name))
    save_clients(clients)
    print(f"added {address} (IPv4 {inner_ipv4(address)})")
    apply()


def cmd_remove(who):
    clients = load_clients()
    keep = [(a, n) for a, n in clients if n != who] if any(n == who for _, n in clients) else None
    if keep is None:
        address = parse_client(who)
        keep = [(a, n) for a, n in clients if a != address]
    if len(keep) == len(clients):
        die(f"{who} is not a client")
    save_clients(keep)
    apply()


def cmd_list():
    clients = load_clients()
    serving = {address for address, _ in served(clients, warn=False)}
    for address, name in clients:
        note = "" if address in serving else "  (not served: its IPv4 address is taken)"
        print(f"{address}  {inner_ipv4(address)}  {name}".rstrip() + note)


def apply():
    """After a change to the list: apply it now if the daemon runs, and say
    so if it does not (the list is saved either way)."""
    if tun_present(load_config()):
        cmd_up()
    else:
        print("fips-exit: saved; fips-exitd is not running, so nothing was applied "
              "(systemctl start fips-exit)")


def cmd_status():
    config = load_config()
    daemon = run("pgrep", "-x", "fips-exitd", check=False).returncode == 0
    print("daemon fips-exitd: " + ("running" if daemon else "not running"))
    table = run("nft", "list", "table", "inet", TABLE, check=False)
    print("nftables table: " + ("present" if table.returncode == 0 else "absent"))
    if tun_present(config):
        stats = json.loads(run("ip", "-j", "-s", "link", "show", config["TUN"]).stdout)[0]["stats64"]
        # The TUN's point of view: what it receives came from the clients.
        print(f"{config['TUN']}: {stats['rx']['packets']} packets from clients, "
              f"{stats['tx']['packets']} to clients")
    print(f"clients: {len(load_clients())}")


def main(argv):
    commands = {"up": cmd_up, "down": cmd_down, "add": cmd_add, "remove": cmd_remove,
                "list": cmd_list, "status": cmd_status}
    if len(argv) < 2 or argv[1] not in commands:
        sys.exit(__doc__)
    try:
        commands[argv[1]](*argv[2:])
    except TypeError:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
