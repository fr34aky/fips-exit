[Unit]
Description=fips exit node: its advert on Nostr
After=fips-exit.service network-online.target
Wants=network-online.target

[Service]
# Says on the relays in ADVERT_RELAYS (/etc/fips-exit/config) that this exit
# exists, signed with the node's fips key. Does nothing, and succeeds, when
# no relay is named there or the exit is not running.
Type=oneshot
ExecStart=/usr/local/sbin/fips-exit advert
